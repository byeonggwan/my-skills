#!/usr/bin/env bash
# 공개 저장소에 환경 고유 표현이 들어가지 않게 막는다.
# 금지어는 저장소 밖 파일(기본 ~/.config/claude-config/denylist, 한 줄에 정규식 하나)에 둔다.
deny="${CLAUDE_CONFIG_DENYLIST:-$HOME/.config/claude-config/denylist}"
[ -r "$deny" ] || { echo "pre-commit: 금지어 파일이 없어 검사하지 않는다: $deny" >&2; exit 0; }
pattern=$(grep -vE '^\s*(#|$)' "$deny" | paste -sd'|' -)
[ -n "$pattern" ] || exit 0
hits=$(git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r grep -nIE "$pattern" -- 2>/dev/null)
if [ -n "$hits" ]; then
  echo "pre-commit: 환경 고유 표현이 들어 있다. local/로 옮기거나 일반화한 뒤 다시 커밋한다." >&2
  echo "$hits" | cut -c1-200 >&2
  exit 1
fi
